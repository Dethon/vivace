// Data exchanged with the Rust side. Globals keep callbacks out of the
// component tree: any component reads state and reports actions directly.

import { Emblem } from "theme.slint";

export struct TrackData {
    title: string,
    artists: string,
    album: string,
    duration: string,
    added: string,
    cover: image,
    number: int,
    explicit: bool,
    playable: bool,
    current: bool,
    // In Liked Songs, or for an episode in Your Episodes.
    liked: bool,
    // A podcast episode, saved to Your Episodes rather than liked.
    episode: bool,
    // How much of an episode was heard, in 0..1; 0 when not started.
    progress: float,
    // "41 min left" or "Played" for an episode; otherwise empty.
    remaining: string,
    played: bool,
}

export struct CardData {
    title: string,
    subtitle: string,
    cover: image,
    round: bool,
    emblem: Emblem,
}

export enum SaveKind { none, album, artist }

export struct HeaderData {
    kind: string,
    title: string,
    subtitle: string,
    cover: image,
    round: bool,
    emblem: Emblem,
    playable: bool,
    // Which save control the header offers, and whether it is on.
    save: SaveKind,
    saved: bool,
}

// A page is one virtualised list of rows of these kinds.
export enum RowKind { header, section, columns, track, cards, message }

export struct Row {
    kind: RowKind,
    // A section's title, a message, or the heading of a list's date column.
    text: string,
    // A section's "Show all" link; empty for none.
    link: string,
    // Whether the track list this row belongs to shows a "Date added" column.
    dated: bool,
    // The list is a single album: no artwork or album column per track.
    album-view: bool,
    header: HeaderData,
    track: TrackData,
    cards: [CardData],
}

export struct LibraryItem {
    title: string,
    subtitle: string,
    cover: image,
    emblem: Emblem,
    selected: bool,
    // A playlist the user owns: it can be renamed and deleted.
    owned: bool,
    // A playlist that can be taken out of the library.
    removable: bool,
}

export enum RepeatMode { off, all, one }

export enum DeviceIcon { computer, phone, speaker, tv, other }

export struct DeviceItem {
    name: string,
    kind: DeviceIcon,
    active: bool,
    // This computer.
    local: bool,
}

export enum TrackAction { toggle-liked, toggle-played, add-to-queue, open-album, open-artist, remove-from-playlist }

export global Player {
    // Whether a track is loaded.
    in property <bool> available;
    in property <string> title;
    in property <string> artists;
    in property <image> cover;
    in property <bool> playing;
    // In Liked Songs, or for an episode in Your Episodes.
    in property <bool> liked;
    in property <bool> episode;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <float> volume: 0.5;
    in property <bool> shuffle;
    in property <RepeatMode> repeat;

    callback toggle();
    callback next();
    callback previous();
    callback seek(int);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-liked();
    callback open-album();
    callback open-artist();

    pure function two-digits(value: int) -> string {
        (value < 10 ? "0" : "") + value
    }

    // `3:07`, or `1:02:07` from an hour up.
    pure public function clock(ms: int) -> string {
        ms >= 3600000 ? Math.floor(ms / 3600000) + ":" + two-digits(Math.mod(Math.floor(ms / 60000), 60)) + ":" + two-digits(Math.mod(Math.floor(ms / 1000), 60)) : Math.floor(ms / 60000) + ":" + two-digits(Math.mod(Math.floor(ms / 1000), 60))
    }
}

export global Nav {
    in property <[Row]> rows;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> home-selected;
    // A page is being fetched; the previous one stays visible meanwhile.
    in property <bool> loading;
    // Scroll offset of the page, saved and restored when moving through history.
    in-out property <length> scroll-y;
    in-out property <string> query;

    callback back();
    callback forward();
    callback open-home();
    callback open-settings();
    callback search(string);
    // The header's play button.
    callback play-page();
    // The header's save or follow control.
    callback toggle-saved();
    // Row index within `rows`.
    callback play-track(int);
    callback track-action(int, TrackAction);
    // Names of the playlists the user can add tracks to.
    in property <[string]> editable-playlists;
    // The page is one of those playlists, so tracks can be removed from it.
    in property <bool> page-editable;
    // Row index, then index into `editable-playlists` or -1 for a new playlist.
    callback add-to-playlist(int, int);
    // Row index and position of the card within it.
    callback open-card(int, int);
    // Follows the "Show all" link of the section titled in a row.
    callback open-section(int);
    // How many cards fit in a row at the current width.
    callback columns-changed(int);
}

export global Library {
    in property <[LibraryItem]> items;
    callback open(int);
    // Ask to rename, or to delete or unfollow, the playlist at this index.
    callback rename(int);
    callback remove(int);
}

export global SettingsView {
    // Shown in place of the page.
    in property <bool> visible;
    // 0 low, 1 normal, 2 very high.
    in property <int> quality: 2;
    in property <bool> normalise;
    in property <string> device-name;
    in property <bool> start-at-login;
    // Whether this system has a tray to close the window to.
    in property <bool> tray-supported;
    in property <bool> close-to-tray;
    // Whether this system shows a notification for each new song.
    in property <bool> notify-supported;
    in property <bool> notify-song-changes;
    in property <string> username;
    in property <string> version;
    in property <string> data-folder;
    callback set-quality(int);
    callback set-normalise(bool);
    callback set-device-name(string);
    callback set-start-at-login(bool);
    callback set-close-to-tray(bool);
    callback set-notify-song-changes(bool);
    callback sign-out();
}

// The one modal question the window can show at a time.
export global Dialog {
    in-out property <bool> visible;
    in property <string> title;
    in property <string> message;
    // Whether the answer is typed; `text` is its initial and final value.
    in property <bool> has-input;
    in-out property <string> text;
    in property <string> confirm-label;
    callback confirmed(string);
}

export global Queue {
    in-out property <bool> visible;
    in property <[TrackData]> items;
    // Leading entries of `items` the user queued by hand.
    in property <int> queued;
    // Name of the playlist or album the rest of the queue comes from.
    in property <string> context;
}

export global LyricsView {
    in-out property <bool> visible;
    in property <[string]> lines;
    // Index of the line being sung; -1 when unknown or the lyrics are unsynced.
    in property <int> current: -1;
    in property <bool> synced;
    // Shown in place of the lines: loading, or that there are none.
    in property <string> status;
    // The panel was opened.
    callback shown();
    // Jump to the line with this index.
    callback seek(int);
}

export global Devices {
    in property <[DeviceItem]> items;
    // Name of the other device that is playing; empty when none is.
    in property <string> remote-name;
    callback transfer(int);
}

export global Session {
    // Shown instead of the page while signing in or after a failure.
    in property <string> status;
    in property <bool> connected;
    // Transient message, such as a failed action.
    in property <string> notice;
}
