import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SettingsView, AppUpdate } from "types.slint";

component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    width: text.preferred-width + 32px;
    height: 32px;
    border-radius: 16px;
    background: root.selected ? Theme.text : touch.has-hover ? Theme.surface-active : Theme.surface-hover;

    text := Text {
        text: root.label;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: 13px;
        font-weight: 600;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.on ? Theme.accent : Theme.surface-active;

    Rectangle {
        x: root.on ? 22px : 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.text;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

component Setting inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;

    spacing: 10px;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-muted;
            font-size: 13px;
            wrap: word-wrap;
        }
    }

    @children
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 22px;
    font-weight: 700;
}

export component SettingsPage inherits Rectangle {
    background: Theme.surface;
    border-radius: 8px;
    clip: true;

    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: Theme.gutter;
            spacing: 28px;

            Text {
                text: "Settings";
                color: Theme.text;
                font-size: 32px;
                font-weight: 800;
            }

            SectionTitle {
                text: "Playback";
            }

            Setting {
                title: "Audio quality";
                detail: "Higher quality uses more data. Changing this restarts playback.";

                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;

                    Choice {
                        label: "Low · 96 kbps";
                        selected: SettingsView.quality == 0;
                        clicked => {
                            SettingsView.set-quality(0);
                        }
                    }

                    Choice {
                        label: "Normal · 160 kbps";
                        selected: SettingsView.quality == 1;
                        clicked => {
                            SettingsView.set-quality(1);
                        }
                    }

                    Choice {
                        label: "Very high · 320 kbps";
                        selected: SettingsView.quality == 2;
                        clicked => {
                            SettingsView.set-quality(2);
                        }
                    }
                }
            }

            Setting {
                title: "Normalise volume";
                detail: "Plays every track at a similar loudness. Changing this restarts playback.";

                HorizontalLayout {
                    alignment: start;

                    Toggle {
                        on: SettingsView.normalise;
                        toggled => {
                            SettingsView.set-normalise(!SettingsView.normalise);
                        }
                    }
                }
            }

            if SettingsView.normalise: Setting {
                title: "Volume level";
                detail: "How loud normalised tracks play; loud may cost some dynamic range. Changing this restarts playback.";

                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;

                    for label[index] in ["Quiet", "Normal", "Loud"]: Choice {
                        label: label;
                        selected: SettingsView.volume-level == index;
                        clicked => {
                            SettingsView.set-volume-level(index);
                        }
                    }
                }
            }

            Setting {
                title: "Gapless playback";
                detail: "Starts the next track with no silence between them. Changing this restarts playback.";

                HorizontalLayout {
                    alignment: start;

                    Toggle {
                        on: SettingsView.gapless;
                        toggled => {
                            SettingsView.set-gapless(!SettingsView.gapless);
                        }
                    }
                }
            }

            Setting {
                title: "Autoplay";
                detail: "Keeps playing similar songs when what you play ends. Changing this restarts playback.";

                HorizontalLayout {
                    alignment: start;

                    Toggle {
                        on: SettingsView.autoplay;
                        toggled => {
                            SettingsView.set-autoplay(!SettingsView.autoplay);
                        }
                    }
                }
            }

            Setting {
                title: "Device name";
                detail: "How this computer appears in Spotify's device list. Press Enter to apply; leave it empty for the default name.";

                HorizontalLayout {
                    alignment: start;

                    Rectangle {
                        width: 320px;
                        height: 40px;
                        border-radius: Theme.radius;
                        background: Theme.surface-hover;
                        border-width: 1px;
                        border-color: name.has-focus ? Theme.text-muted : Theme.divider;

                        // The text line is thinner than the box: a click
                        // anywhere on the box starts typing.
                        TouchArea {
                            mouse-cursor: text;
                            clicked => {
                                name.focus();
                            }
                        }

                        name := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 20px;
                            text: SettingsView.device-name;
                            color: Theme.text;
                            font-size: 14px;
                            single-line: true;
                            selection-background-color: Theme.accent;
                            selection-foreground-color: Theme.on-accent;
                            accepted => {
                                SettingsView.set-device-name(self.text);
                            }
                        }
                    }
                }
            }

            SectionTitle {
                text: "Desktop";
            }

            Setting {
                title: "Open Vivace when you sign in";
                detail: "Starts minimised when you sign in to your computer.";

                HorizontalLayout {
                    alignment: start;

                    Toggle {
                        on: SettingsView.start-at-login;
                        toggled => {
                            SettingsView.set-start-at-login(!SettingsView.start-at-login);
                        }
                    }
                }
            }

            if SettingsView.tray-supported: Setting {
                title: "Keep Vivace in the notification area";
                detail: "Closing the window leaves Vivace playing, with its icon by the clock.";

                HorizontalLayout {
                    alignment: start;

                    Toggle {
                        on: SettingsView.close-to-tray;
                        toggled => {
                            SettingsView.set-close-to-tray(!SettingsView.close-to-tray);
                        }
                    }
                }
            }

            if SettingsView.notify-supported: Setting {
                title: "Show a notification when the song changes";
                detail: "Names each new song as it starts playing here.";

                HorizontalLayout {
                    alignment: start;

                    Toggle {
                        on: SettingsView.notify-song-changes;
                        toggled => {
                            SettingsView.set-notify-song-changes(!SettingsView.notify-song-changes);
                        }
                    }
                }
            }

            SectionTitle {
                text: "Account";
            }

            Setting {
                title: SettingsView.username == "" ? "Not signed in" : "Signed in as " + SettingsView.username;
                detail: "Signing out forgets the saved login on this computer.";

                HorizontalLayout {
                    alignment: start;

                    Choice {
                        label: "Sign out";
                        clicked => {
                            SettingsView.sign-out();
                        }
                    }
                }
            }

            SectionTitle {
                text: "About";
            }

            Setting {
                title: "Vivace " + SettingsView.version;
                detail: "An unofficial client; not affiliated with Spotify. Made with Slint.";
            }

            Setting {
                title: "Updates";
                detail: AppUpdate.checking ? "Checking for updates…" : AppUpdate.status;

                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;

                    if AppUpdate.version != "": Choice {
                        label: AppUpdate.ready ? "Restart to update" : "Download " + AppUpdate.version;
                        selected: true;
                        clicked => {
                            if AppUpdate.ready {
                                AppUpdate.install();
                            } else {
                                AppUpdate.open-page();
                            }
                        }
                    }

                    Choice {
                        label: "Check now";
                        clicked => {
                            AppUpdate.check();
                        }
                    }
                }
            }

            Setting {
                title: "Check for updates automatically";
                detail: "Looks for a new version when Vivace starts and once a day.";

                HorizontalLayout {
                    alignment: start;

                    Toggle {
                        on: SettingsView.check-for-updates;
                        toggled => {
                            SettingsView.set-check-for-updates(!SettingsView.check-for-updates);
                        }
                    }
                }
            }

            Setting {
                title: "Data folder";
                detail: SettingsView.data-folder;
            }
        }
    }
}
