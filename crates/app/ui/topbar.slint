import { Theme, Icons, Icon, IconButton } from "theme.slint";
import { Nav, SettingsView } from "types.slint";

export component TopBar inherits Rectangle {
    // Moves keyboard focus to the search field.
    public function focus-search() {
        input.focus();
    }

    // Room left free at the right end for the window controls.
    in property <length> end-inset;

    height: 48px;

    HorizontalLayout {
        spacing: 8px;
        padding-right: root.end-inset;

        VerticalLayout {
            alignment: center;

            IconButton {
                icon: Icons.back;
                icon-size: 24px;
                enabled: Nav.can-go-back;
                clicked => {
                    Nav.back();
                }
            }
        }

        VerticalLayout {
            alignment: center;

            IconButton {
                icon: Icons.forward;
                icon-size: 24px;
                enabled: Nav.can-go-forward;
                clicked => {
                    Nav.forward();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 160px;
            max-width: 420px;

            Rectangle {
                height: 40px;
                border-radius: 20px;
                background: input.has-focus ? Theme.surface-active : Theme.surface-hover;
                border-width: input.has-focus ? 1px : 0;
                border-color: Theme.text-muted;

                Icon {
                    x: 12px;
                    path: Icons.search;
                    tint: input.has-focus ? Theme.text : Theme.text-muted;
                }

                if input.text == "": Text {
                    x: 44px;
                    text: "What do you want to play?";
                    color: Theme.text-faint;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                input := TextInput {
                    x: 44px;
                    width: parent.width - 60px;
                    height: 20px;
                    text <=> Nav.query;
                    color: Theme.text;
                    font-size: 14px;
                    single-line: true;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    edited => {
                        Nav.search(self.text);
                    }
                    accepted => {
                        Nav.search(self.text);
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;

            IconButton {
                icon: Icons.settings;
                icon-size: 20px;
                active: SettingsView.visible;
                clicked => {
                    Nav.open-settings();
                }
            }
        }
    }
}

// A caption button glyph, drawn with thin strokes like the system's own.
component CaptionButton inherits Rectangle {
    in property <string> glyph;
    // Turns red on hover, for the close button.
    in property <bool> destructive;
    callback clicked();

    width: 46px;
    height: 32px;
    background: touch.has-hover ? (root.destructive ? #c42b1c : Theme.surface-hover) : transparent;

    Path {
        width: 10px;
        height: 10px;
        commands: root.glyph;
        stroke: touch.has-hover ? Theme.text : Theme.text-muted;
        stroke-width: 1px;
        viewbox-width: 10;
        viewbox-height: 10;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Minimize, maximize/restore and close, for the frameless window.
export component WindowControls inherits HorizontalLayout {
    in property <bool> maximized;
    callback minimize();
    callback toggle-maximized();
    callback close();

    CaptionButton {
        glyph: "M0 5.5H10";
        clicked => {
            root.minimize();
        }
    }

    CaptionButton {
        glyph: root.maximized ? "M2.5 0.5H9.5V7.5M0.5 2.5H7.5V9.5H0.5Z" : "M0.5 0.5H9.5V9.5H0.5Z";
        clicked => {
            root.toggle-maximized();
        }
    }

    CaptionButton {
        glyph: "M0 0L10 10M10 0L0 10";
        destructive: true;
        clicked => {
            root.close();
        }
    }
}
