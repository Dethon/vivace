import { ListView } from "std-widgets.slint";
import { Theme, Icons, Icon, Cover, Emblem } from "theme.slint";
import { Library, Nav, LibraryItem } from "types.slint";

component NavButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.surface-hover : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;

            Icon {
                path: root.icon;
                size: 22px;
                tint: root.selected || touch.has-hover ? Theme.text : Theme.text-muted;
            }
        }

        Text {
            text: root.label;
            color: root.selected || touch.has-hover ? Theme.text : Theme.text-muted;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component LibraryRow inherits Rectangle {
    in property <LibraryItem> item;
    callback clicked();
    callback rename();
    callback remove();

    height: 56px;
    border-radius: Theme.radius;
    background: root.item.selected ? Theme.surface-active : touch.has-hover ? Theme.surface-hover : transparent;

    area := ContextMenuArea {
        enabled: root.item.removable;

        Menu {
            if root.item.owned: MenuItem {
                title: "Rename";
                activated => {
                    root.rename();
                }
            }

            MenuItem {
                title: root.item.remove-label;
                activated => {
                    root.remove();
                }
            }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                Cover {
                    source: root.item.cover;
                    size: 40px;
                    round: root.item.round;
                    emblem: root.item.emblem;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.item.title;
                    color: Theme.text;
                    font-size: 14px;
                    overflow: elide;
                }

                Text {
                    text: root.item.subtitle;
                    color: Theme.text-muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
            // The touch area takes the click before the menu area sees it.
            pointer-event(event) => {
                if root.item.removable && event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    area.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    width: text.preferred-width + 14px;
    height: 28px;
    border-radius: 14px;
    background: root.selected ? Theme.text : touch.has-hover ? Theme.surface-active : Theme.surface-hover;

    text := Text {
        text: root.label;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: 12px;
        font-weight: 600;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits Rectangle {
    background: Theme.surface;
    border-radius: 8px;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        NavButton {
            icon: Icons.home;
            label: "Home";
            selected: Nav.home-selected;
            clicked => {
                Nav.open-home();
            }
        }

        HorizontalLayout {
            height: 36px;
            padding-left: 12px;
            padding-right: 4px;

            Text {
                text: "Your Library";
                color: Theme.text-muted;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            sort := Rectangle {
                width: sort-label.preferred-width + 34px;
                border-radius: Theme.radius;
                background: sort-touch.has-hover ? Theme.surface-hover : transparent;

                sort-menu := ContextMenuArea {
                    Menu {
                        for label[index] in Library.sorts: MenuItem {
                            title: label;
                            checkable: true;
                            checked: index == Library.sort;
                            activated => {
                                Library.set-sort(index);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    sort-label := Text {
                        text: Library.sorts[Library.sort];
                        color: sort-touch.has-hover ? Theme.text : Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;

                        Icon {
                            path: Icons.sort;
                            size: 14px;
                            tint: sort-touch.has-hover ? Theme.text : Theme.text-muted;
                        }
                    }
                }

                sort-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        sort-menu.show({ x: 0, y: self.height });
                    }
                }
            }
        }

        if Library.folder == "": Flickable {
            height: 36px;
            content-width: chips.preferred-width;

            chips := HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                alignment: start;

                for label[index] in ["Playlists", "Albums", "Artists", "Podcasts"]: VerticalLayout {
                    alignment: center;

                    Chip {
                        label: label;
                        selected: Library.filter == index;
                        clicked => {
                            Library.set-filter(Library.filter == index ? -1 : index);
                        }
                    }
                }
            }
        }

        if Library.folder != "": Rectangle {
            height: 36px;
            border-radius: Theme.radius;
            background: up-touch.has-hover ? Theme.surface-hover : transparent;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        path: Icons.back;
                        size: 18px;
                        tint: Theme.text;
                    }
                }

                Text {
                    text: Library.folder;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            up-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Library.close-folder();
                }
            }
        }

        ListView {
            for item[index] in Library.items: LibraryRow {
                item: item;
                clicked => {
                    Library.open(index);
                }
                rename => {
                    Library.rename(index);
                }
                remove => {
                    Library.remove(index);
                }
            }
        }
    }
}
