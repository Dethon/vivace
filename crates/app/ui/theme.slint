export component Icon inherits Rectangle {
    in property <string> path;
    in property <brush> tint: Theme.text-muted;
    in property <length> size: 20px;

    width: self.size;
    height: self.size;

    Path {
        width: 100%;
        height: 100%;
        commands: root.path;
        fill: root.tint;
        viewbox-width: 24;
        viewbox-height: 24;
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 20px;
    // Drawn in the accent colour, for toggles that are on.
    in property <bool> active;
    in property <bool> enabled: true;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.surface-active : transparent;
    opacity: self.enabled ? 1 : 0.35;

    Icon {
        path: root.icon;
        size: root.icon-size;
        tint: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Artwork with a neutral placeholder until the image arrives. Corners are
// rounded in the bitmap itself, so nothing is clipped while scrolling.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <length> size: 48px;
    in property <bool> round;
    // Draws the Liked Songs emblem instead of artwork.
    in property <bool> liked-songs;

    width: self.size;
    height: self.size;
    border-radius: self.round ? self.size / 2 : clamp(self.size * 5%, 3px, 10px);
    background: self.liked-songs ? @linear-gradient(135deg, #5b3df5 0%, #b9a8ff 100%) : self.source.width > 0 ? transparent : Theme.placeholder;

    if root.liked-songs || root.source.width == 0: Icon {
        path: root.liked-songs ? Icons.heart : Icons.note;
        size: min(root.size * 45%, 64px);
        tint: root.liked-songs ? white : Theme.text-faint;
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
    }
}

// Horizontal bar reporting a 0..1 fraction; used for seeking and volume.
export component Bar inherits Rectangle {
    in property <float> value;
    // Report while dragging rather than only on release.
    in property <bool> live;
    in property <bool> enabled: true;
    callback changed(float);

    property <float> dragged: clamp(touch.mouse-x / self.width, 0, 1);
    property <float> shown: touch.pressed ? self.dragged : clamp(self.value, 0, 1);
    property <bool> highlighted: self.enabled && (touch.has-hover || touch.pressed);

    height: 16px;

    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-active;

        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            border-radius: 2px;
            background: root.highlighted ? Theme.accent : Theme.text;
        }
    }

    if root.highlighted: Rectangle {
        x: root.width * root.shown - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
    }

    touch := TouchArea {
        enabled: root.enabled;
        moved => {
            if root.live && self.pressed {
                root.changed(root.dragged);
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.changed(root.dragged);
            }
        }
    }
}
