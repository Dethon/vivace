// Colours, metrics and vector icons shared by every component.

export global Theme {
    out property <color> background: #0d0e12;
    out property <color> surface: #15161c;
    out property <color> surface-hover: #1d1f27;
    out property <color> surface-active: #282b36;
    out property <color> divider: #ffffff12;
    out property <color> text: #f3f4f8;
    out property <color> text-muted: #a4a8b8;
    out property <color> text-faint: #6d7182;
    out property <color> accent: #8f7dff;
    out property <color> accent-hover: #a596ff;
    out property <color> on-accent: #0d0e12;
    out property <color> placeholder: #23252e;
    out property <length> radius: 6px;
    out property <length> gutter: 24px;
}

