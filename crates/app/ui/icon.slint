import { Icons } from "theme.slint";

// The application icon, drawn here so it can be regenerated at any size:
// `cargo run -p vivace --example icon`, which also rounds its corners.
export component AppIcon inherits Window {
    in property <length> size: 128px;

    width: self.size;
    height: self.size;
    no-frame: true;

    Rectangle {
        background: @linear-gradient(135deg, #5b3df5 0%, #b9a8ff 100%);

        Path {
            width: root.size * 58%;
            height: root.size * 58%;
            commands: Icons.note;
            fill: white;
            viewbox-width: 24;
            viewbox-height: 24;
        }
    }
}
