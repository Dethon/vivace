; Vivace installer.
;
; Built by scripts/package.py, which supplies:
;   VERSION   the version from Cargo.toml, e.g. 0.1.0
;   DIST      the directory holding vivace.exe and LICENSE.txt
;   ICON      the application icon (.ico)
;   OUTFILE   where to write the installer
;   PUBLISHER (optional) the name shown as publisher in Windows' app list
;
; Vivace updates itself by running a downloaded installer with
;   /S /relaunch
; and quitting: the installer then waits for it to close, and opens the new
; version when done.
;
; Installs for the current user only, so it never asks for administrator
; rights. Everything it writes lives under the install directory and HKCU,
; and the uninstaller removes exactly that. The user's login and settings,
; in %APPDATA%\vivace and %LOCALAPPDATA%\vivace, are kept for a reinstall.

Unicode true
ManifestDPIAware true
RequestExecutionLevel user
SetCompressor /SOLID lzma

!ifndef VERSION
  !error "VERSION is not defined; build with scripts/package.py"
!endif

!define NAME "Vivace"
!define EXE "vivace.exe"
!define DESCRIPTION "A light, fast Spotify player"
!define SETTINGS_KEY "Software\Vivace"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Vivace"
; Where Vivace's own "Open Vivace when you sign in" setting puts its entry.
!define RUN_KEY "Software\Microsoft\Windows\CurrentVersion\Run"

Name "${NAME}"
OutFile "${OUTFILE}"
InstallDir "$LOCALAPPDATA\Programs\${NAME}"
; Reinstalling or upgrading goes where the previous version went.
InstallDirRegKey HKCU "${SETTINGS_KEY}" "InstallDir"

VIProductVersion "${VERSION}.0"
VIAddVersionKey "ProductName" "${NAME}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "FileDescription" "${NAME} Setup"
VIAddVersionKey "FileVersion" "${VERSION}"
!ifdef PUBLISHER
  VIAddVersionKey "CompanyName" "${PUBLISHER}"
  VIAddVersionKey "LegalCopyright" "${PUBLISHER}"
!else
  VIAddVersionKey "LegalCopyright" ""
!endif

!include "MUI2.nsh"
!include "FileFunc.nsh"
!include "LogicLib.nsh"

; How long a copy of Vivace that is quitting gets to let go of its file:
; tries, a quarter of a second apart.
!define WAIT_TRIES 60

!define MUI_ICON "${ICON}"
!define MUI_UNICON "${ICON}"
; Side panel of the first and last pages; generated by the icon example.
!define MUI_WELCOMEFINISHPAGE_BITMAP "welcome.bmp"
!define MUI_ABORTWARNING
!define MUI_WELCOMEPAGE_TEXT "Setup will install ${NAME} ${VERSION} for your user account. No administrator rights are needed.$\r$\n$\r$\n${NAME} plays Spotify with a Premium account."
!define MUI_FINISHPAGE_RUN "$INSTDIR\${EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "Open ${NAME}"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Section "Install"
  SetOutPath "$INSTDIR"

  ; A running copy, which may sit in the notification area, keeps its file
  ; locked. One that is quitting, as when it updates itself, is waited for;
  ; otherwise report that plainly rather than leave a half-updated install.
  SetOverwrite try
  StrCpy $R0 0
  retry:
    ClearErrors
    File "${DIST}\${EXE}"
    ${If} ${Errors}
      ${If} $R0 < ${WAIT_TRIES}
        IntOp $R0 $R0 + 1
        Sleep 250
        Goto retry
      ${EndIf}
      MessageBox MB_OK|MB_ICONEXCLAMATION "${NAME} is running. Quit it, from its icon by the clock if need be, and run Setup again." /SD IDOK
      Abort "${NAME} is running."
    ${EndIf}
  SetOverwrite on

  File "${DIST}\LICENSE.txt"
  File "/oname=vivace.ico" "${ICON}"
  WriteUninstaller "$INSTDIR\uninstall.exe"

  WriteRegStr HKCU "${SETTINGS_KEY}" "InstallDir" "$INSTDIR"

  CreateShortcut "$SMPROGRAMS\${NAME}.lnk" "$INSTDIR\${EXE}" "" "$INSTDIR\vivace.ico" 0 "" "" "${DESCRIPTION}"

  ; Settings > Apps > Installed apps.
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayName" "${NAME}"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\vivace.ico"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr HKCU "${UNINSTALL_KEY}" "QuietUninstallString" '"$INSTDIR\uninstall.exe" /S'
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoRepair" 1
  !ifdef PUBLISHER
    WriteRegStr HKCU "${UNINSTALL_KEY}" "Publisher" "${PUBLISHER}"
  !endif
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "EstimatedSize" "$0"
SectionEnd

; The finish page opens Vivace after an install with pages; this does after
; one Vivace started itself to update.
Function .onInstSuccess
  ${GetParameters} $R0
  ClearErrors
  ${GetOptions} $R0 "/relaunch" $R1
  ${IfNot} ${Errors}
    Exec '"$INSTDIR\${EXE}"'
  ${EndIf}
FunctionEnd

Section "Uninstall"
  ClearErrors
  Delete "$INSTDIR\${EXE}"
  IfErrors 0 not_running
    MessageBox MB_OK|MB_ICONEXCLAMATION "${NAME} is running. Quit it, from its icon by the clock if need be, and try again." /SD IDOK
    Abort "${NAME} is running."
  not_running:

  Delete "$INSTDIR\LICENSE.txt"
  Delete "$INSTDIR\vivace.ico"
  Delete "$INSTDIR\uninstall.exe"
  ; Only the files above are removed, and the directory only if that leaves
  ; it empty: it may be a folder the user chose that holds other things.
  RMDir "$INSTDIR"

  Delete "$SMPROGRAMS\${NAME}.lnk"

  ; Nothing is left to start at sign-in.
  DeleteRegValue HKCU "${RUN_KEY}" "Vivace"
  DeleteRegKey HKCU "${UNINSTALL_KEY}"
  DeleteRegKey HKCU "${SETTINGS_KEY}"
SectionEnd
